    {
      "id": "kodori-sql-v4-q07",
      "file": "kodori_q07.sql",
      "title": "Q7. ROW_NUMBER / RANK / DENSE_RANK 비교",
      "level": "03 · 랭킹",
      "stage": 3,
      "dataset": "common",
      "rules": [
        "amount가 NULL이 아닌 행을 amount 내림차순으로 세 함수 모두 매기세요. 컬럼: id, shop, amount, rn, rnk, drnk ROW_NUMBER는 동점일 때 id 오름차순으로 매기고, 최종 결과는 rn 순으로 정렬하세요.",
        "컬럼 이름·개수와 행 순서를 비교하며, 숫자는 소수 둘째 자리까지 비교해요."
      ],
      "concept": "amount가 NULL이 아닌 행을 amount 내림차순으로 세 함수 모두 매기세요. 컬럼: id, shop, amount, rn, rnk, drnk ROW_NUMBER는 동점일 때 id 오름차순으로 매기고, 최종 결과는 rn 순으로 정렬하세요.",
      "hints": [
        "ROW_NUMBER에는 amount DESC, id를, RANK와 DENSE_RANK에는 amount DESC만 사용해요."
      ],
      "solution": "SELECT id, shop, amount, ROW_NUMBER() OVER (ORDER BY amount DESC, id) AS rn, RANK() OVER w AS rnk, DENSE_RANK() OVER w AS drnk\nFROM sales WHERE amount IS NOT NULL WINDOW w AS (ORDER BY amount DESC) ORDER BY rn;",
      "explanation": "공통 SQLite 데이터 기준 정답입니다.",
      "starter": "",
      "columns": [
        "id",
        "shop",
        "amount",
        "rn",
        "rnk",
